{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Sync Meet Map repos (pull)",
      "type": "shell",
      "command": "npm run sync:pull",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false,
        "close": true
      },
      "problemMatcher": []
    }
  ]
}
