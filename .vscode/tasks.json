{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Mac arrival (pull + npm ci)",
      "type": "shell",
      "command": "npm run mac:arrival",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false,
        "close": true
      },
      "problemMatcher": []
    }
  ]
}
